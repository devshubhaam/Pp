# Main (manager) bot token from BotFather
MAIN_BOT_TOKEN=

# Tumhara Telegram numeric user ID (sirf tum main bot chala sakoge)
OWNER_ID=

# MongoDB Atlas connection string
MONGO_URI=
DB_NAME=filebot

# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# Render service ka public URL, e.g. https://myfilebot.onrender.com (no trailing slash)
BASE_URL=

# Koi bhi lamba random string
WEBHOOK_SECRET=

# Private channels ke IDs (-100 se shuru)
PRIMARY_CHANNEL=
BACKUP_CHANNEL=

# Health check interval seconds (default 300)
HEALTH_INTERVAL=300

# Render start command:
# uvicorn main:app --host 0.0.0.0 --port $PORT
